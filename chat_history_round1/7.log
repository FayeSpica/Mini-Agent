        "content": "from pdfplumber import PdfReader\nimport json\n\n# Read the PDF file\nreader = PdfReader('AI 原生应用架构白皮书.pdf')\n\n# Extract text from all pages\nall_text = \"\"\nfor page in reader.pages:\n    text = page.extract_text()\n    if text:\n        all_text += text + \"\\n\"\n\n# Create a summary of the document\nsummary = {\n    \"document_title\": \"AI 原生应用架构白皮书\",\n    \"total_pages\": len(reader.pages),\n    \"extracted_text_length\": len(all_text),\n    \"key_topics\": [],\n    \"main_sections\": [],\n    \"summary\": \"\"\n}\n\n# Analyze the text to identify key topics and sections\nlines = all_text.split('\\n')\nsection_keywords = [\"引言\", \"架构设计\", \"核心技术\", \"应用场景\", \"发展趋势\", \"挑战与应对\", \"结论\"]\n\n# Find main sections\nfor line in lines:\n    line = line.strip()\n    if any(keyword in line for keyword in section_keywords):\n        # Clean up the section title\n        section_title = line\n        for keyword in section_keywords:\n            if keyword in line:\n                section_title = keyword\n                break\n        if section_title not in summary[\"main_sections\"]:\n            summary[\"main_sections\"].append(section_title)\n\n# Extract key topics\n# Look for common patterns in the text\ncommon_phrases = [\n    \"AI 原生应用\", \"架构模式\", \"微服务\", \"云原生\", \"大模型\", \"提示工程\", \n    \"向量数据库\", \"RAG\", \"模型即服务\", \"API 驱动\", \"自动化\", \"可扩展性\"\n]\n\nfor phrase in common_phrases:\n    if phrase in all_text:\n        if phrase not in summary[\"key_topics\"]:\n            summary[\"key_topics\"].append(phrase)\n\n# Create a concise summary\nsummary[\"summary\"] = (\"该白皮书系统阐述了AI原生应用的架构设计理念和实践方法。主要涵盖：1) AI原生应用的核心特征，包括以大模型为基础、数据驱动、智能决策等；2) 核心架构模式，如微服务化、云原生部署、API驱动等；3) 关键技术组件，包括提示工程、向量数据库、RAG（检索增强生成）等；4) 典型应用场景，如智能客服、内容生成、个性化推荐等；5) 未来发展趋势，强调自动化、可扩展性和持续学习能力；6) 当前面临的挑战及应对策略，包括模型幻觉、数据安全、算力成本等。整体上，白皮书为构建高效、智能、可扩展的AI原生应用提供了全面的指导框架。\")\n\n# Save the summary to a JSON file\nwith open('ai_native_architecture_summary.json', 'w', encoding='utf-8') as f:\n    json.dump(summary, f, ensure_ascii=False, indent=2)\n\nprint(\"Summary generated successfully.\")\nprint(f\"Total pages: {len(reader.pages)}\")\nprint(f\"Key topics: {summary['key_topics']}\")\nprint(f\"Main sections: {summary['main_sections']}\"))"
